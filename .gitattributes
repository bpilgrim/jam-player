# Keep C# as the repository's detected language.
#
# Linguist ignores Markdown (prose), so without committed code this repo shows no
# language at all. These rules make sure the sample code is what gets counted.

# Linguist classifies everything under a `samples/` directory as documentation
# (documentation.yml matches `^[Ss]amples?/`), and documentation is excluded from
# language stats before the linguist-detectable attribute is even consulted. Without
# this override the C# below is present but uncounted, and the repo reports no
# language at all.
samples/** linguist-documentation=false

*.cs linguist-detectable=true

# XAML is detected as XML and would otherwise outrank the C# it accompanies.
*.xaml linguist-detectable=false

# Project scaffolding is not a language sample.
*.csproj linguist-detectable=false
*.sln linguist-detectable=false
*.slnx linguist-detectable=false
*.props linguist-detectable=false
*.targets linguist-detectable=false

# Normalize line endings for source.
* text=auto
*.cs text diff=csharp
